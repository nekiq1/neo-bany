# ============================================
# cp .env.example .env.local
# ============================================

# --- PocketBase (записи в базу) ---
# Локально: http://127.0.0.1:8090
# Прод:     https://pb.your-domain.ru
VITE_PB_URL=http://127.0.0.1:8090

# --- ИИ: ключ НЕ в клиенте ---
# Задайте на сервере PocketBase (docker-compose / systemd env):
#   AI_API_KEY=sk-...
#   AI_API_BASE=https://api.openai.com/v1
#   AI_MODEL=gpt-4o-mini
# Клиент ходит на POST {VITE_PB_URL}/api/pspbrf/ai

# (устаревшие Supabase / VITE_ADMIN_* / VITE_AI_* больше не нужны)
